{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "youtast",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/feed/*", "/media/*", "/chapters/*", "/subscribe/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "youtast",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "youtast-audio",
    },
  ],
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
  "vars": {
    "MAX_STORAGE_BYTES": "8000000000",
    "MAX_USER_STORAGE_BYTES": "2000000000",
    "MAX_AUDIO_BYTES": "90000000",
    "MAX_CHANNELS": "20",
  },
  "observability": {
    "enabled": false,
  },
}
